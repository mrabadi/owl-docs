{
  "name": "owl-docs-figure-editor",
  "version": "0.1.0",
  "private": true,
  "description": "The bundled, local-only Excalidraw figure editor for Owl Docs.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "build:web": "npm run prepare-assets && vite build",
    "build": "npm run build:web && electron-builder --linux dir",
    "install:app": "./install.sh",
    "start": "electron ."
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "5.4.21",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "electron": "32.3.3",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.owldocs.figure-editor",
    "productName": "Owl Docs Figure Editor",
    "artifactName": "owl-docs-figure-editor-${version}-${arch}.${ext}",
    "files": ["dist/index.html", "dist/assets/**", "dist/fonts/**", "electron/**", "package.json", "!node_modules/**"],
    "linux": {
      "target": ["dir"],
      "category": "Graphics"
    }
  }
}
